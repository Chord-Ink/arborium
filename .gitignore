/Cargo.lock
target
xtask/target/
_site
demo/.icon-cache.json
__pycache__

# Library crates don't need Cargo.lock (consumers use their own)
crates/**/Cargo.lock
!crates/arborium-cli/Cargo.lock
langs/**/Cargo.lock

# Version is derived from git tag in CI, not stored in repo
version.json

# Grammar generation cache
.cache/

# Claude Code handoff documents
.handoffs/

# Node modules (created during grammar regeneration)
node_modules/
**/node_modules/

# ============================================================
# GENERATED FILES - regenerated by `cargo xtask gen`
# ============================================================

# Rust manifests, generated sources, and language crates are committed so
# Cargo Git dependencies can build without running xtask.
packages/arborium/package.json

# Language crate build inputs are under crates/arborium-languages/.

# New structure (langs/) - Generated files
# Generated tree-sitter files in def/grammar/src/ (parser.c, grammar.json, etc.)
langs/group-*/*/def/grammar/src/

# Legacy generated crate location (no longer used)
langs/group-*/*/crate/

# WASM plugin packages (generated from def/)
langs/group-*/*/npm/

# Generated demo/plugin manifests
demo/index.html
demo/plugins.json
langs/plugins.json
packages/arborium/src/plugins-manifest.ts

# Generated NPM theme CSS files
packages/arborium/src/themes/*.css

# ============================================================

# Pre-compressed demo files
demo/*.br
demo/*.gz
demo/rustdoc-comparison/
crates/arborium-docsrs-demo/demo/rustdoc-comparison/
/dist/
crates/arborium-host/target/
packages/arborium/dist/
packages/arborium/node_modules/
tests/visual/diffs
.tracey/
.playwright-mcp/

# Local CodeGraph index
.codegraph/
