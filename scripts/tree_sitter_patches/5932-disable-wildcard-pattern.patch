Issue: https://github.com/tree-sitter/tree-sitter/issues/5932
Fix reported by Michael Sloan (mgsloan). Keep the wildcard prefix in bounds.

--- a/src/query.c
+++ b/src/query.c
@@ -3410,6 +3410,9 @@
   for (unsigned i = 0; i < self->pattern_map.size; i++) {
     PatternEntry *pattern = array_get(&self->pattern_map, i);
     if (pattern->pattern_index == pattern_index) {
+      if (i < self->wildcard_root_pattern_count) {
+        self->wildcard_root_pattern_count--;
+      }
       array_erase(&self->pattern_map, i);
       i--;
     }
